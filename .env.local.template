# ── SUPABASE ──
# From: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── STRIPE ──
# From: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_or_test_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Price ID for the $49 family activation product
STRIPE_PRICE_ID=price_your_price_id_here

# ── TWILIO ──
# From: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token-here
# EstateDesk Twilio number (buy one for this product)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ── ANTHROPIC ──
# From: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── RESEND (email) ──
# From: resend.com → API Keys
RESEND_API_KEY=re_your-key-here
RESEND_FROM_EMAIL=noreply@estatedesk.com

# ── APP ──
NEXT_PUBLIC_APP_URL=https://estatedesk.taskrocket.org
# Secret for signing family tokens (run: openssl rand -base64 32)
TOKEN_SECRET=your-32-char-secret-here
